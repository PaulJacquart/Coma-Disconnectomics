  shorttitle = {{{MR Imaging}} for {{Differentiating Contrast Staining}} from {{Hemorrhagic Transformation}} after {{Endovascular Thrombectomy}} in {{Acute Ischemic Stroke}}},
  author = {You, S.-H. and Kim, B. and Kim, B.K. and Suh, S.-i.},
  year = 2018,
