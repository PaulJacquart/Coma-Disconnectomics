@article{Seners2023a,
  title = {Determinants of {{Infarct Core Growth During Inter-hospital Transfer}} for {{Thrombectomy}}},
  author = {Seners, Pierre and Scheldeman, Lauranne and Christensen, Soren and Mlynash, Michael and Ter Schiphorst, Adrien and Arquizan, Caroline and Costalat, Vincent and Henon, Hilde and Bretzner, Martin and Heit, Jeremy J. and Olivot, Jean-Marc and Lansberg, Maarten G. and Albers, Gregory W. and {the Infarct-Growth Collaborators}},
