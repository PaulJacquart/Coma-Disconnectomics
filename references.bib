  file = {/Users/paul/Zotero/storage/5P3HCFH9/Müller et al. - 2023 - The non-specific matrix thalamus facilitates the cortical information processing modes relevant for.pdf}
}

@article{Munn2021,
  title = {The Ascending Arousal System Shapes Neural Dynamics to Mediate Awareness of Cognitive States},
  author = {Munn, Brandon R. and M{\"u}ller, Eli J. and Wainstein, Gabriel and Shine, James M.},
