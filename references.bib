@article{Tseng2022,
  title = {The Subthalamic Corticotropin-Releasing Hormone Neurons Mediate Adaptive {{REM-sleep}} Responses to Threat},
  author = {Tseng, Yu-Ting and Zhao, Binghao and Chen, Shanping and Ye, Jialin and Liu, Jingjing and Liang, Lisha and Ding, Hui and Schaefke, Bernhard and Yang, Qin and Wang, Lina and Wang, Feng and Wang, Liping},
  year = 2022,
