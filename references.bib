@article{Zhang2023,
  title = {Higher-Order Interactions Shape Collective Dynamics Differently in Hypergraphs and Simplicial Complexes},
  author = {Zhang, Yuanzhao and Lucas, Maxime and Battiston, Federico},
  year = 2023,
