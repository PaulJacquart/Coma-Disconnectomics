@article{He2025,
  title = {{{DeepNuParc}}: {{A}} Novel Deep Clustering Framework for Fine-Scale Parcellation of Brain Nuclei Using Diffusion {{MRI}} Tractography},
  shorttitle = {{{DeepNuParc}}},
  author = {He, Haolin and Zhu, Ce and Zhang, Le and Liu, Yipeng and Xu, Xiao and Chen, Yuqian and Zekelman, Leo and Rushmore, Jarrett and Rathi, Yogesh and Makris, Nikos and O'Donnell, Lauren J. and Zhang, Fan},
