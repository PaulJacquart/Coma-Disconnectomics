  file = {/Users/paul/Zotero/storage/9E7ZRGMM/Silva et al. - 2026 - Stepwise clinical and diagnostic strategy for coma of unknown origin.pdf}
}

@article{Sinzinger2026,
  title = {Impact of Tractogram Filtering and Graph Creation for Structural Connectomics in Subjects with {{Parkinson}}'s Disease},
