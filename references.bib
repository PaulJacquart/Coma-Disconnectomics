@article{Bastiani2019,
  title = {Automated Quality Control for within and between Studies Diffusion {{MRI}} Data Using a Non-Parametric Framework for Movement and Distortion Correction},
  author = {Bastiani, Matteo and Cottaar, Michiel and Fitzgibbon, Sean P. and Suri, Sana and {Alfaro-Almagro}, Fidel and Sotiropoulos, Stamatios N. and Jbabdi, Saad and Andersson, Jesper L.R.},
