@article{Palacios2022,
  title = {Diffusion {{Tensor Imaging Reveals Elevated Diffusivity}} of {{White Matter Microstructure}} That {{Is Independently Associated}} with {{Long-Term Outcome}} after {{Mild Traumatic Brain Injury}}: {{A TRACK-TBI Study}}},
  shorttitle = {Diffusion {{Tensor Imaging Reveals Elevated Diffusivity}} of {{White Matter Microstructure}} That {{Is Independently Associated}} with {{Long-Term Outcome}} after {{Mild Traumatic Brain Injury}}},
  author = {Palacios, Eva M. and Yuh, Esther L. and Mac Donald, Christine L. and Bourla, Ioanna and {Wren-Jarvis}, Jamie and Sun, Xiaoying and Vassar, Mary J. and {Diaz-Arrastia}, Ramon and Giacino, Joseph T. and Okonkwo, David O. and Robertson, Claudia S. and Stein, Murray B. and Temkin, Nancy and McCrea, Michael A. and Levin, Harvey S. and Markowitz, Amy J. and Jain, Sonia and Manley, Geoffrey T. and Mukherjee, Pratik and {on behalf of the TRACK-TBI Investigators} and Adeoye, Opeolu and Badjatia, Neeraj and Boase, Kim and Barber, Jason and Bodien, Yelena and Bullock, M. Ross and Chesnut, Randall and D. Corrigan, John and Crawford, Karen and Dikmen, Sureyya and Duhaime, Ann-Christine and Ellenbogen, Richard and Ramana Feeser, V and R. Ferguson, Adam and Foreman, Brandon and Gardner, Raquel and Gaudette, Etienne and Goldman, Dana and Gonzalez, Luis and Gopinath, Shankar and Gullapalli, Rao and Hemphill, J. Claude and Hotz, Gillian and Keene, C. Dirk and K. Korley, Frederick and Kramer, Joel and Kreitzer, Natalie and Lindsell, Chris and Machamer, Joan and Madden, Christopher and Martin, Alastair and McAllister, Thomas and Merchant, Randall and Nelson, Lindsay and B. Ngwenya, Laura and Noel, Florence and Nolan, Amber and Perl, Daniel and Puccio, Ava and Rabinowitz, Miri and Rosand, Jonathan and Sander, Angelle and Satris, Gabriella and Schnyer, David and Seabury, Seth and Sherer, Mark and Taylor, Sabrina and Toga, Arthur and Valadka, Alex and Vespa, Paul and Wang, Kevin and K. Yue, John and Zafonte, Ross},
  year = 2022,
  month = oct,
  journal = {Journal of Neurotrauma},
  volume = {39},
  number = {19-20},
  pages = {1318--1328},
  issn = {0897-7151, 1557-9042},
  doi = {10.1089/neu.2021.0408},
  urldate = {2026-08-21},
  abstract = {Diffusion tensor imaging (DTI) literature on single-center studies contains conflicting results regarding acute effects of mild traumatic brain injury (mTBI) on white matter (WM) microstructure and the prognostic significance. This larger-scale multi-center DTI study aimed to determine how acute mTBI affects WM microstructure over time and how early WM changes affect long-term outcome. From Transforming Research and Clinical Knowledge in Traumatic Brain Injury (TRACK-TBI), a cohort study at 11 United States level 1 trauma centers, a total of 391 patients with acute mTBI ages 17 to 60 years were included and studied at two weeks and six months post-injury. Demographically matched friends or family of the participants were the control group (               n               \,=\,148). Axial diffusivity (AD), fractional anisotropy (FA), mean diffusivity (MD), and radial diffusivity (RD) were the measures of WM microstructure. The primary outcome was the Glasgow Outcome Scale Extended (GOSE) score of injury-related functional limitations across broad life domains at six months post-injury. The AD, MD, and RD were higher and FA was lower in mTBI versus friend control (FC) at both two weeks and six months post-injury throughout most major WM tracts of the cerebral hemispheres. In the mTBI group, AD and, to a lesser extent, MD decreased in WM from two weeks to six months post-injury. At two weeks post-injury, global WM AD and MD were both independently associated with six-month incomplete recovery (GOSE {$<$}8 vs\,=\,8) even after accounting for demographic, clinical, and other imaging factors. DTI provides reliable imaging biomarkers of dynamic WM microstructural changes after mTBI that have utility for patient selection and treatment response in clinical trials. Continued technological advances in the sensitivity, specificity, and precision of diffusion magnetic resonance imaging hold promise for routine clinical application in mTBI.},
  langid = {english},
  file = {/Users/paul/Zotero/storage/FDH85TW3/Palacios et al. - 2022 - Diffusion Tensor Imaging Reveals Elevated Diffusivity of White Matter Microstructure that Is Indepen.pdf}
}

@article{Panagiotaki2012,
  title = {Compartment Models of the Diffusion {{MR}} Signal in Brain White Matter: {{A}} Taxonomy and Comparison},
