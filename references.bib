  author = {{\v S}koch, Anton{\'i}n and Reh{\'a}k Bu{\v c}kov{\'a}, Barbora and Mare{\v s}, Jan and Tint{\v e}ra, Jaroslav and Sanda, Pavel and Jajcay, Lucia and Hor{\'a}{\v c}ek, Ji{\v r}{\'i} and {\v S}paniel, Filip and Hlinka, Jaroslav},
