@article{Frohlich2022,
  title = {Neural Complexity Is a Common Denominator of Human Consciousness across Diverse Regimes of Cortical Dynamics},
  author = {Frohlich, Joel and Chiang, Jeffrey N. and Mediano, Pedro A. M. and Nespeca, Mark and Saravanapandian, Vidya and Toker, Daniel and Dell'Italia, John and Hipp, Joerg F. and Jeste, Shafali S. and Chu, Catherine J. and Bird, Lynne M. and Monti, Martin M.},
  year = 2022,
