@article{Prabha2025,
  title = {{{MULTIMODAL EXPLAINABLE-AI FRAMEWORK FOR STROKE AND TRAUMATIC BRAIN INJURY DETECTION AND PROGNOSIS USING IMAGING AND CLINICAL DATA IN MACHINE LEARNING}}},
